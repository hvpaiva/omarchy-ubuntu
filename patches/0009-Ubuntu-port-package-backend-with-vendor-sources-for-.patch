+#!/bin/bash
+
+# omarchy:summary=Ubuntu port package backend: Arch names resolved to apt, vendor repos, .debs, Omarchy packages, flatpaks, mise tools and fonts
+# omarchy:args=apt-names|installed|install|remove|launch-id <package...>
+# omarchy:hidden=true
+# omarchy:requires-sudo=true
+
+set -uo pipefail
+export LC_ALL=C
+
+OPR_URL=https://pkgs.omarchy.org/stable/x86_64
+OPR_STATE=/var/lib/omarchy-ubuntu/opr
+
+declare -A APT_ALIASES=(
+  [google-chrome]="google-chrome-stable"
+  [visual-studio-code-bin]="code"
+  [spotify]="spotify-client"
+  [pam-u2f]="libpam-u2f"
+  [dropbox]="nautilus-dropbox"
+  [dropbox-cli]="nautilus-dropbox"
+  [libappindicator-gtk3]="libayatana-appindicator3-1"
+  [python-gpgme]="python3-gpg"
+  [libreoffice-fresh]="libreoffice"
+  [docker]="docker-ce docker.io"
+  [docker-compose]="docker-compose-plugin docker-compose-v2"
+  [libyaml]="libyaml-dev"
+  [php]="php-cli"
+  [php-sqlite]="php-sqlite3"
+  [xdebug]="php-xdebug"
+  [freerdp]="freerdp3-x11"
+  [openbsd-netcat]="netcat-openbsd"
+  [python-protobuf]="python3-protobuf"
+  [wine-staging]="wine"
+  [wine-mono]="wine"
+  [wine-gecko]="wine"
+  [retroarch-assets-glui]="retroarch-assets"
+  [retroarch-assets-ozone]="retroarch-assets"
+  [retroarch-assets-xmb]="retroarch-assets"
+)
+
+declare -A RECIPES=(
+  [grok-bot]="pool grok-bot https://downloads.cursor.com/aptrepo grok-bot main"
+  [openai-codex-desktop]="pool chatgpt https://persistent.oaistatic.com/codex-app-prod/linux/deb stable main"
+  [perplexity]="pool perplexity https://packages.perplexity.ai/deb stable main"
+  [microsoft-edge-stable-bin]="pool microsoft-edge-stable https://packages.microsoft.com/repos/edge stable main"
+  [brave-bin]="repo brave brave-browser"
+  [brave-origin-bin]="repo brave brave-origin"
+  [signal-desktop]="repo signal signal-desktop"
+  [sublime-text-4]="repo sublime sublime-text"
+  [nordvpn-bin]="repo nordvpn nordvpn nordvpn-gui"
+  [lmstudio-bin]="deb lm-studio https://lmstudio.ai/download/latest/linux/x64?format=deb"
+  [bitwarden]="deb bitwarden https://vault.bitwarden.com/download/?app=desktop&platform=linux&variant=deb"
+  [minecraft-launcher]="deb minecraft-launcher https://launcher.mojang.com/download/Minecraft.deb"
+  [heroic-games-launcher-bin]="deb heroic github:Heroic-Games-Launcher/HeroicGamesLauncher:linux-amd64\.deb$"
+  [sunshine]="deb sunshine github:LizardByte/Sunshine:ubuntu24\.04_amd64\.deb$"
+  [umu-launcher]="deb umu-launcher github:Open-Wine-Components/umu-launcher:python3-umu-launcher_.*_amd64_ubuntu-noble\.deb$ github:Open-Wine-Components/umu-launcher:/umu-launcher_.*_all_ubuntu-noble\.deb$"
+  [once-bin]="opr once-bin"
+  [omazed]="opr omazed"
+  [omarchy-emacs]="opr omarchy-emacs emacs-pgtk"
+  [t3code-bin]="opr t3code-bin"
+  [openclaw]="opr openclaw"
+  [hermes-desktop]="opr hermes-desktop"
+  [xpadneo-dkms]="opr xpadneo-dkms dkms"
+  [moonlight-qt]="flatpak com.moonlight_stream.Moonlight"
+  [zed]="custom zed"
+  [zen-browser-bin]="custom zen"
+  [steam]="custom steam"
+  [helix]="mise helix helix hx"
+  [bitwarden-cli]="mise bitwarden bw"
+  [symfony-cli]="mise github:symfony-cli/symfony-cli symfony"
+  [ttf-cascadia-mono-nerd]="nerdfont CascadiaMono CaskaydiaMono"
+  [ttf-meslo-nerd]="nerdfont Meslo MesloLG"
+  [ttf-firacode-nerd]="nerdfont FiraCode FiraCode"
+  [ttf-victor-mono-nerd]="nerdfont VictorMono VictorMono"
+  [ttf-bitstream-vera-mono-nerd]="nerdfont BitstreamVeraSansMono BitstromWera"
+  [ttf-iosevka-nerd]="nerdfont Iosevka Iosevka"
+  [ttf-jetbrains-mono-nerd]="nerdfont JetBrainsMono JetBrainsMono"
+  [lib32-vulkan-intel]="i386 mesa-vulkan-drivers"
+  [lib32-vulkan-radeon]="i386 mesa-vulkan-drivers"
+  [lib32-nvidia-utils]="custom nvidia-i386"
+  [lib32-nvidia-580xx-utils]="custom nvidia-i386"
+  [libretro-vice-x64dtv-git]="skip the libretro buildbot publishes no x64dtv core"
+)
+
+declare -A LIBRETRO_CORES=(
+  [libretro-beetle-pce]=mednafen_pce
+  [libretro-beetle-pce-fast]=mednafen_pce_fast
+  [libretro-beetle-psx]=mednafen_psx
+  [libretro-beetle-psx-hw]=mednafen_psx_hw
+  [libretro-beetle-supergrafx]=mednafen_supergrafx
+  [libretro-blastem]=blastem
+  [libretro-bsnes]=bsnes
+  [libretro-bsnes-hd]=bsnes_hd_beta
+  [libretro-desmume]=desmume
+  [libretro-dolphin]=dolphin
+  [libretro-flycast]=flycast
+  [libretro-gambatte]=gambatte
+  [libretro-genesis-plus-gx]=genesis_plus_gx
+  [libretro-kronos]=kronos
+  [libretro-mame]=mame
+  [libretro-melonds]=melonds
+  [libretro-mesen]=mesen
+  [libretro-mesen-s]=mesen-s
+  [libretro-mgba]=mgba
+  [libretro-mupen64plus-next]=mupen64plus_next
+  [libretro-nestopia]=nestopia
+  [libretro-parallel-n64]=parallel_n64
+  [libretro-picodrive]=picodrive
+  [libretro-play]=play
+  [libretro-ppsspp]=ppsspp
+  [libretro-sameboy]=sameboy
+  [libretro-scummvm]=scummvm
+  [libretro-snes9x]=snes9x
+  [libretro-yabause]=yabause
+  [libretro-cap32-git]=cap32
+  [libretro-fbneo-git]=fbneo
+  [libretro-uae-git]=puae
+  [libretro-vice-x128-git]=vice_x128
+  [libretro-vice-x64-git]=vice_x64
+  [libretro-vice-x64sc-git]=vice_x64sc
+  [libretro-vice-xcbm2-git]=vice_xcbm2
+  [libretro-vice-xcbm5x0-git]=vice_xcbm5x0
+  [libretro-vice-xpet-git]=vice_xpet
+  [libretro-vice-xplus4-git]=vice_xplus4
+  [libretro-vice-xscpu64-git]=vice_xscpu64
+  [libretro-vice-xvic-git]=vice_xvic
+)
+
+declare -A LIBRETRO_ASSETS=(
+  [libretro-core-info]="info:info"
+  [libretro-overlays]="overlays:overlays"
+  [libretro-shaders-slang]="shaders_slang:shaders/shaders_slang"
+  [retroarch-joypad-autoconfig-git]="autoconfig:autoconfig"
+  [libretro-database-git]="database-rdb:database/rdb cheats:database/cht database-cursors:database/cursors"
+)
+
+declare -A REPOS=(
+  [brave]="https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg|deb [arch=amd64 signed-by=KEYRING] https://brave-browser-apt-release.s3.brave.com/ stable main"
+  [signal]="https://updates.signal.org/desktop/apt/keys.asc|deb [arch=amd64 signed-by=KEYRING] https://updates.signal.org/desktop/apt xenial main"
+  [sublime]="https://download.sublimetext.com/sublimehq-pub.gpg|deb [signed-by=KEYRING] https://download.sublimetext.com/ apt/stable/"
+  [nordvpn]="https://repo.nordvpn.com/gpg/nordvpn_public.asc|deb [arch=amd64 signed-by=KEYRING] https://repo.nordvpn.com/deb/nordvpn/debian stable main"
+)
+
+as_root() {
+  if (( EUID == 0 )); then
+    "$@"
+  else
+    sudo "$@"
+  fi
+}
+
+base_name() {
+  local name=${1%%[<>=]*}
+  name=${name%-bin}
+  printf '%s\n' "${name%-git}"
+}
+
+apt_names() {
+  local name=${1%%[<>=]*} base out
+  base=$(base_name "$name")
+  out=""
+  [[ -n ${APT_ALIASES[$name]-} ]] && out+=" ${APT_ALIASES[$name]}"
+  [[ $base != "$name" && -n ${APT_ALIASES[$base]-} ]] && out+=" ${APT_ALIASES[$base]}"
+  out+=" $name"
+  [[ $base != "$name" ]] && out+=" $base"
+  printf '%s\n' $out | awk '!seen[$0]++'
+}
+
+recipe_of() {
+  local name=${1%%[<>=]*}
+  if [[ -n ${LIBRETRO_CORES[$name]-} ]]; then
+    printf 'libretro %s\n' "${LIBRETRO_CORES[$name]}"
+  elif [[ -n ${LIBRETRO_ASSETS[$name]-} ]]; then
+    printf 'libretro-assets %s\n' "${LIBRETRO_ASSETS[$name]}"
+  elif [[ -n ${RECIPES[$name]-} ]]; then
+    printf '%s\n' "${RECIPES[$name]}"
+  elif [[ -n ${RECIPES[$(base_name "$name")]-} ]]; then
+    printf '%s\n' "${RECIPES[$(base_name "$name")]}"
+  else
+    return 1
+  fi
+}
+
+apt_candidate() {
+  local candidate
+  candidate=$(apt-cache policy "$1" 2>/dev/null | awk '/^  Candidate:/ { print $2 }')
+  [[ -n $candidate && $candidate != "(none)" ]]
+}
+
+dpkg_installed() {
+  [[ $(dpkg-query -W -f='${db:Status-Abbrev}' "$1" 2>/dev/null) == ?i* ]]
+}
+
+dpkg_provided() {
+  dpkg-query -W -f='${db:Status-Abbrev}\t${Provides}\n' 2>/dev/null |
+    awk -F'\t' -v want="$1" '
+      $1 ~ /^.i/ {
+        n = split($2, p, ",")
+        for (i = 1; i <= n; i++) {
+          gsub(/^ +| +$| *\(.*\)/, "", p[i])
+          if (p[i] == want) found = 1
+        }
+      }
+      END { exit !found }'
+}
+
+github_asset_url() {
+  local repo=$1 pattern=$2
+  curl -fsSL "https://api.github.com/repos/$repo/releases/latest" |
+    grep -o '"browser_download_url": *"[^"]*"' |
+    sed 's/.*"\(https[^"]*\)"$/\1/' |
+    grep -E -- "$pattern" | head -1
+}
+
+resolve_url() {
+  local url=$1
+  if [[ $url == github:* ]]; then
+    url=${url#github:}
+    github_asset_url "${url%%:*}" "${url#*:}"
+  else
+    printf '%s\n' "$url"
+  fi
+}
+
+download() {
+  local url=$1 target=$2
+  url=$(resolve_url "$url") || return 1
+  [[ -n $url ]] || { echo "No download found for $1" >&2; return 1; }
+  echo "Downloading $url"
+  curl -fL --retry 3 --progress-bar -o "$target" "$url"
+}
+
+with_workdir() {
+  local dir status
+  dir=$(mktemp -d)
+  (cd "$dir" && "$@")
+  status=$?
+  rm -rf "$dir"
+  return $status
+}
+
+install_local_debs() {
+  local -a debs=()
+  local deb
+  for deb in "$@"; do
+    debs+=("./$deb")
+  done
+  as_root apt-get install -y "${debs[@]}"
+}
+
+keyring_path() {
+  printf '/etc/apt/keyrings/omarchy-%s.gpg\n' "$1"
+}
+
+sources_path() {
+  printf '/etc/apt/sources.list.d/omarchy-%s.list\n' "$1"
+}
+
+repo_ready() {
+  [[ -s $(keyring_path "$1") && -s $(sources_path "$1") ]]
+}
+
+fetch_keyring() {
+  curl -fsSL "$1" -o key || return 1
+  if grep -q -- '-----BEGIN PGP' key; then
+    gpg --dearmor <key >key.gpg
+  else
+    mv key key.gpg
+  fi
+}
+
+add_repo() {
+  local id=$1 key_url line keyring
+  IFS='|' read -r key_url line <<<"${REPOS[$id]}"
+  keyring=$(keyring_path "$id")
+  echo "Adding the $id apt repository"
+  fetch_keyring "$key_url" || return 1
+  as_root install -Dm644 key.gpg "$keyring" || return 1
+  echo "${line//KEYRING/$keyring}" | as_root tee "$(sources_path "$id")" >/dev/null || return 1
+  as_root apt-get update -o Dir::Etc::sourcelist="$(sources_path "$id")" -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0
+}
+
+install_repo() {
+  local id=$1
+  shift
+  if ! repo_ready "$id"; then
+    with_workdir add_repo "$id" || return 1
+  fi
+  as_root apt-get install -y "$@"
+}
+
+pool_index() {
+  local base=$1 suite=$2 component=$3
+  curl -fsSL "$base/dists/$suite/$component/binary-amd64/Packages" 2>/dev/null ||
+    curl -fsSL "$base/dists/$suite/$component/binary-amd64/Packages.gz" | gunzip
+}
+
+pool_filename() {
+  local package=$1
+  pool_index "$2" "$3" "$4" |
+    awk -v want="$package" '
+      /^Package: / { name = $2 }
+      /^Version: / { version = $2 }
+      /^Filename: / { if (name == want) print version "\t" $2 }' |
+    sort -V | tail -1 | cut -f2
+}
+
+fetch_and_install_pool() {
+  local package=$1 base=$2 filename
+  filename=$(pool_filename "$@")
+  [[ -n $filename ]] || { echo "No $package in $base" >&2; return 1; }
+  download "$base/${filename// /%20}" "$package.deb" && install_local_debs "$package.deb"
+}
+
+install_pool() {
+  with_workdir fetch_and_install_pool "$@"
+}
+
+fetch_and_install_debs() {
+  local url index=0
+  local -a debs=()
+  for url in "$@"; do
+    index=$((index + 1))
+    download "$url" "package-$index.deb" || return 1
+    debs+=("package-$index.deb")
+  done
+  install_local_debs "${debs[@]}"
+}
+
+install_deb() {
+  shift
+  with_workdir fetch_and_install_debs "$@"
+}
+
+opr_manifest() {
+  printf '%s/%s.files\n' "$OPR_STATE" "$1"
+}
+
+opr_lookup() {
+  local name=$1 desc
+  curl -fsSL "$OPR_URL/omarchy.db" -o omarchy.db || return 1
+  mkdir db && tar -xf omarchy.db -C db || return 1
+  for desc in db/*/desc; do
+    if [[ $(awk '/^%NAME%$/ { getline; print; exit }' "$desc") == "$name" ]]; then
+      awk '/^%FILENAME%$/ { getline; f = $0 } /^%SHA256SUM%$/ { getline; s = $0 } END { print f " " s }' "$desc"
+      return 0
+    fi
+  done
+  echo "No $name in the Omarchy package repository" >&2
+  return 1
+}
+
+opr_stem() {
+  local stem=${1%-bin}
+  printf '%s\n' "${stem%-dkms}"
+}
+
+hook() {
+  local fn="$1_${2//-/_}"
+  shift 2
+  if declare -F "$fn" >/dev/null; then
+    "$fn" "$@"
+  fi
+}
+
+fetch_and_install_opr() {
+  local name=$1 filename sha
+  read -r filename sha < <(opr_lookup "$name") || return 1
+  [[ -n $filename ]] || return 1
+  download "$OPR_URL/$filename" package.pkg.tar.zst || return 1
+  echo "$sha  package.pkg.tar.zst" | sha256sum -c --quiet || return 1
+  tar --zstd -tf package.pkg.tar.zst | grep -vE '^\.(PKGINFO|BUILDINFO|MTREE|INSTALL)$' >files || return 1
+  as_root tar --zstd -xf package.pkg.tar.zst -C / --no-overwrite-dir --keep-directory-symlink \
+    --exclude=.PKGINFO --exclude=.BUILDINFO --exclude=.MTREE --exclude=.INSTALL || return 1
+  as_root install -Dm644 files "$(opr_manifest "$name")" || return 1
+  if grep -q '^usr/lib/systemd/' files; then
+    as_root systemctl daemon-reload
+  fi
+}
+
+install_opr() {
+  local name=$1
+  shift
+  if (( $# > 0 )); then
+    as_root apt-get install -y "$@" || return 1
+  fi
+  hook before_opr "$name" || return 1
+  with_workdir fetch_and_install_opr "$name" || return 1
+  hook after_opr "$name"
+}
+
+remove_opr() {
+  local name=$1 manifest stem entry
+  manifest=$(opr_manifest "$name")
+  [[ -f $manifest ]] || return 0
+  hook before_opr_removal "$name"
+  stem=$(opr_stem "$name")
+  while IFS= read -r entry; do
+    [[ $entry == */ ]] || as_root rm -f "/$entry"
+  done <"$manifest"
+  while IFS= read -r entry; do
+    [[ $entry == */ && $entry == *"$stem"* ]] && as_root rmdir --ignore-fail-on-non-empty "/$entry"
+  done < <(sort -r "$manifest")
+  as_root rm -f "$manifest"
+}
+
+opr_module_version() {
+  local dir
+  dir=$(compgen -G "/usr/src/$1-*" | sort -V | tail -1)
+  printf '%s\n' "${dir##*/$1-}"
+}
+
+before_opr_xpadneo_dkms() {
+  as_root apt-get install -y "linux-headers-$(uname -r)"
+}
+
+after_opr_xpadneo_dkms() {
+  as_root dkms install -m hid-xpadneo -v "$(opr_module_version hid-xpadneo)"
+}
+
+before_opr_removal_xpadneo_dkms() {
+  as_root dkms remove -m hid-xpadneo -v "$(opr_module_version hid-xpadneo)" --all
+}
+
+build_hermes_pty() {
+  local app=/opt/hermes-desktop electron pty_dir pty_version
+  electron=$(<"$app/version")
+  pty_dir="$app/resources/app.asar.unpacked/dist/node_modules/node-pty"
+  pty_version=$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$pty_dir/package.json" | head -1)
+  echo "Rebuilding node-pty $pty_version for Electron $electron against this system's glibc"
+  npm pack "node-pty@$pty_version" --silent >/dev/null &&
+    tar -xzf "node-pty-$pty_version.tgz" &&
+    (cd package && npm install --ignore-scripts --omit=dev --silent &&
+      PYTHON=/usr/bin/python3 npx --yes node-gyp rebuild --target="$electron" --arch=x64 --dist-url=https://electronjs.org/headers >/dev/null) &&
+    as_root install -m755 package/build/Release/pty.node "$pty_dir/build/Release/pty.node"
+}
+
+after_opr_hermes_desktop() {
+  as_root apt-get install -y build-essential python3 git jq || return 1
+  with_workdir build_hermes_pty
+}
+
+install_flatpak() {
+  flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null ||
+    as_root flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
+  flatpak install -y --noninteractive flathub "$1"
+}
+
+install_mise() {
+  local tool=$1 command=$2 bin=${3:-$2}
+  omarchy-mise-install "$tool" "$command" "$bin" &&
+    MISE_MINIMUM_RELEASE_AGE=0 mise use -g --quiet "$tool"
+}
+
+nerdfont_dir() {
+  printf '%s/.local/share/fonts/%s\n' "$HOME" "$1"
+}
+
+fetch_nerdfont() {
+  download "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/$1.tar.xz" font.tar.xz &&
+    mkdir -p "$(nerdfont_dir "$1")" &&
+    tar -xJf font.tar.xz -C "$(nerdfont_dir "$1")" --wildcards '*.ttf'
+}
+
+install_nerdfont() {
+  with_workdir fetch_nerdfont "$1" && fc-cache -f "$(nerdfont_dir "$1")" >/dev/null
+}
+
+i386_enabled() {
+  dpkg --print-foreign-architectures | grep -x i386 >/dev/null
+}
+
+enable_i386() {
+  i386_enabled && return 0
+  echo "Enabling the i386 architecture for 32-bit libraries"
+  as_root dpkg --add-architecture i386 && as_root apt-get update
+}
+
+install_i386() {
+  enable_i386 && as_root apt-get install -y "$1:i386"
+}
+
+nvidia_gl_package() {
+  dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'libnvidia-gl-*' 2>/dev/null |
+    awk '$1 ~ /^.i/ && $2 !~ /:i386$/ { print $2; exit }'
+}
+
+install_custom_nvidia_i386() {
+  local package
+  package=$(nvidia_gl_package)
+  [[ -n $package ]] || { echo "No NVIDIA driver package (libnvidia-gl-*) is installed" >&2; return 1; }
+  install_i386 "$package"
+}
+
+installed_custom_nvidia_i386() {
+  local package
+  package=$(nvidia_gl_package)
+  [[ -n $package ]] && dpkg_installed "$package:i386"
+}
+
+remove_custom_nvidia_i386() {
+  local package
+  package=$(nvidia_gl_package)
+  [[ -z $package ]] || as_root apt-get purge -y "$package:i386"
+}
+
+install_custom_steam() {
+  enable_i386 && as_root apt-get install -y steam-installer
+}
+
+installed_custom_steam() {
+  dpkg_installed steam-installer || dpkg_installed steam-launcher
+}
+
+remove_custom_steam() {
+  local package
+  for package in steam-installer steam-launcher; do
+    dpkg_installed "$package" && as_root apt-get purge -y --autoremove "$package"
+  done
+  return 0
+}
+
+install_custom_zed() {
+  curl -fsSL https://zed.dev/install.sh | sh
+}
+
+installed_custom_zed() {
+  [[ -x $HOME/.local/zed.app/bin/zed ]]
+}
+
+remove_custom_zed() {
+  rm -rf "$HOME/.local/zed.app" "$HOME/.local/bin/zed" "$HOME/.local/share/applications/dev.zed.Zed.desktop"
+}
+
+zen_desktop_entry() {
+  cat <<'EOF'
+[Desktop Entry]
+Name=Zen Browser
+Comment=Experience tranquillity while browsing the web without people tracking you!
+Exec=/usr/bin/zen-browser %u
+Icon=/opt/zen-browser/browser/chrome/icons/default/default128.png
+Type=Application
+MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;application/x-xpinstall;application/pdf;application/json;
+StartupWMClass=zen
+Categories=Network;WebBrowser;
+StartupNotify=true
+Terminal=false
+Actions=new-window;new-private-window;
+
+[Desktop Action new-window]
+Name=Open a New Window
+Exec=/usr/bin/zen-browser --new-window %u
+
+[Desktop Action new-private-window]
+Name=Open a New Private Window
+Exec=/usr/bin/zen-browser --private-window %u
+EOF
+}
+
+fetch_and_install_zen() {
+  download "github:zen-browser/desktop:zen\.linux-x86_64\.tar\.xz$" zen.tar.xz || return 1
+  as_root rm -rf /opt/zen-browser &&
+    as_root mkdir -p /opt/zen-browser &&
+    as_root tar -xJf zen.tar.xz -C /opt/zen-browser --strip-components=1 &&
+    as_root ln -sf /opt/zen-browser/zen /usr/bin/zen-browser &&
+    zen_desktop_entry | as_root tee /usr/share/applications/zen.desktop >/dev/null
+}
+
+install_custom_zen() {
+  with_workdir fetch_and_install_zen
+}
+
+installed_custom_zen() {
+  [[ -x /opt/zen-browser/zen ]]
+}
+
+remove_custom_zen() {
+  as_root rm -rf /opt/zen-browser /usr/bin/zen-browser /usr/share/applications/zen.desktop
+}
+
+libretro_core_path() {
+  printf '/usr/lib/libretro/%s_libretro.so\n' "$1"
+}
+
+fetch_and_install_libretro_core() {
+  download "https://buildbot.libretro.com/nightly/linux/x86_64/latest/$1_libretro.so.zip" core.zip &&
+    unzip -o -q core.zip &&
+    as_root install -Dm644 "$1_libretro.so" "$(libretro_core_path "$1")"
+}
+
+install_libretro() {
+  with_workdir fetch_and_install_libretro_core "$1"
+}
+
+fetch_and_install_libretro_assets() {
+  local spec zip dest
+  for spec in "$@"; do
+    zip=${spec%%:*}
+    dest=/usr/share/libretro/${spec#*:}
+    download "https://buildbot.libretro.com/assets/frontend/$zip.zip" "$zip.zip" || return 1
+    as_root mkdir -p "$dest" && as_root unzip -o -q "$zip.zip" -d "$dest" || return 1
+  done
+}
+
+install_libretro_assets() {
+  with_workdir fetch_and_install_libretro_assets "$@"
+}
+
+libretro_assets_installed() {
+  local spec
+  for spec in "$@"; do
+    [[ -n $(ls -A "/usr/share/libretro/${spec#*:}" 2>/dev/null) ]] || return 1
+  done
+}
+
+remove_libretro_assets() {
+  local spec
+  for spec in "$@"; do
+    as_root rm -rf "/usr/share/libretro/${spec#*:}"
+  done
+}
+
+with_recipe() {
+  local fn=$1
+  local -a words
+  read -ra words <<<"$2"
+  "$fn" "${words[@]}"
+}
+
+recipe_installed() {
+  local kind=$1
+  shift
+  case $kind in
+  repo) dpkg_installed "$2" ;;
+  pool | deb) dpkg_installed "$1" ;;
+  opr) [[ -s $(opr_manifest "$1") ]] ;;
+  flatpak) flatpak info "$1" &>/dev/null ;;
+  mise) command -v "$2" &>/dev/null ;;
+  nerdfont) fc-list : family | grep -iE "^$2[^,]* Nerd Font" >/dev/null ;;
+  i386) dpkg_installed "$1:i386" ;;
+  custom) "installed_custom_${1//-/_}" ;;
+  libretro) [[ -f $(libretro_core_path "$1") ]] ;;
+  libretro-assets) libretro_assets_installed "$@" ;;
+  skip) return 0 ;;
+  esac
+}
+
+recipe_install() {
+  local kind=$1
+  shift
+  case $kind in
+  repo) install_repo "$@" ;;
+  pool) install_pool "$@" ;;
+  deb) install_deb "$@" ;;
+  opr) install_opr "$@" ;;
+  flatpak) install_flatpak "$@" ;;
+  mise) install_mise "$@" ;;
+  nerdfont) install_nerdfont "$@" ;;
+  i386) install_i386 "$@" ;;
+  custom) "install_custom_${1//-/_}" ;;
+  libretro) install_libretro "$@" ;;
+  libretro-assets) install_libretro_assets "$@" ;;
+  skip) echo "Skipping on Ubuntu: $*" ;;
+  esac
+}
+
+purge_installed() {
+  local -a installed=()
+  local package
+  for package in "$@"; do
+    dpkg_installed "$package" && installed+=("$package")
+  done
+  if (( ${#installed[@]} > 0 )); then
+    as_root apt-get purge -y --autoremove "${installed[@]}"
+  fi
+}
+
+recipe_remove() {
+  local kind=$1
+  shift
+  case $kind in
+  repo) shift && purge_installed "$@" ;;
+  pool | deb) purge_installed "$1" ;;
+  opr) remove_opr "$1" ;;
+  flatpak) flatpak info "$1" &>/dev/null && flatpak uninstall -y --noninteractive "$1" ;;
+  mise)
+    rm -f "$HOME/.local/bin/$2"
+    mise rm -g "$1" &>/dev/null
+    mise uninstall --all "$1" &>/dev/null
+    ;;
+  nerdfont) rm -rf "$(nerdfont_dir "$1")" && fc-cache -f >/dev/null ;;
+  i386) dpkg_installed "$1:i386" && as_root apt-get purge -y "$1:i386" ;;
+  custom) "remove_custom_${1//-/_}" ;;
+  libretro) as_root rm -f "$(libretro_core_path "$1")" ;;
+  libretro-assets) remove_libretro_assets "$@" ;;
+  esac
+  return 0
+}
+
+installed() {
+  local pkg=$1 recipe name
+  if recipe=$(recipe_of "$pkg"); then
+    with_recipe recipe_installed "$recipe"
+    return
+  fi
+  for name in $(apt_names "$pkg"); do
+    dpkg_installed "$name" && return 0
+    dpkg_provided "$name" && return 0
+    snap list "$name" &>/dev/null && return 0
+    flatpak list --app --columns=application 2>/dev/null | grep -i -- "${name//-/_}" >/dev/null && return 0
+    command -v "$name" &>/dev/null && return 0
+  done
+  return 1
+}
+
+install() {
+  local pkg name recipe found
+  local -a apt_pkgs=() recipes=()
+  for pkg in "$@"; do
+    installed "$pkg" && continue
+    if recipe=$(recipe_of "$pkg"); then
+      recipes+=("$recipe")
+      continue
+    fi
+    found=""
+    for name in $(apt_names "$pkg"); do
+      if apt_candidate "$name"; then
+        found=$name
+        break
+      fi
+    done
+    if [[ -z $found ]]; then
+      echo -e "\033[31mError: no Ubuntu source for '$pkg'.\033[0m" >&2
+      return 1
+    fi
+    apt_pkgs+=("$found")
+  done
+
+  if (( ${#apt_pkgs[@]} > 0 )); then
+    as_root apt-get install -y "${apt_pkgs[@]}" || return 1
+  fi
+  for recipe in "${recipes[@]}"; do
+    with_recipe recipe_install "$recipe" || return 1
+  done
+}
+
+remove() {
+  local pkg name recipe
+  local -a debs=() snaps=()
+  local -A selected=()
+  for pkg in "$@"; do
+    if recipe=$(recipe_of "$pkg"); then
+      with_recipe recipe_remove "$recipe"
+      continue
+    fi
+    for name in $(apt_names "$pkg"); do
+      [[ -z ${selected[$name]-} ]] || break
+      if dpkg_installed "$name"; then
+        debs+=("$name")
+        selected[$name]=1
+        break
+      elif snap list "$name" &>/dev/null; then
+        snaps+=("$name")
+        selected[$name]=1
+        break
+      fi
+    done
+  done
+
+  if (( ${#debs[@]} > 0 )); then
+    as_root apt-get purge -y --autoremove "${debs[@]}"
+  fi
+  if (( ${#snaps[@]} > 0 )); then
+    as_root snap remove "${snaps[@]}"
+  fi
+  return 0
+}
+
+launch_id() {
+  local recipe kind id
+  if recipe=$(recipe_of "$1"); then
+    read -r kind id _ <<<"$recipe"
+    if [[ $kind == flatpak ]]; then
+      printf '%s\n' "$id"
+      return
+    fi
+  fi
+  printf '%s\n' "$2"
+}
+
+command=${1:-}
+shift || true
+
+case $command in
+apt-names) apt_names "${1:?package name required}" ;;
+installed) installed "${1:?package name required}" ;;
+install) install "$@" ;;
+remove) remove "$@" ;;
+launch-id) launch_id "${1:?package name required}" "${2:?desktop id required}" ;;
+*)
+  echo "Usage: omarchy-pkg-ubuntu apt-names|installed|install|remove|launch-id <package...>" >&2
+  exit 1
+  ;;
+esac
