From f8e03c5e9ffd58f59014eb10c6df4505e4d03d06 Mon Sep 17 00:00:00 2001
From: Highlander Paiva <highlander.paiva@rdstation.com>
Date: Tue, 22 Sep 2026 20:26:40 -0300
Subject: [PATCH 1/6] Ubuntu port: dpkg/snap/flatpak backend for package guards
 and helpers

Without pacman every omarchy-pkg-present guard in the menu evaluated to
"not installed", so the menu offered to install what was already there
and hid the entries for installed apps. omarchy-pkg-installed answers
for a single Arch-style name on Ubuntu: installed dpkg package (or one
that provides it), snap, flatpak whose id contains the name, or command;
-bin/-git suffixes are dropped and the few names that differ on Ubuntu
are mapped (google-chrome, visual-studio-code-bin, brave-bin, spotify,
steam...). It prints the apt candidates with --apt-names.

omarchy-pkg-present/missing go through it (unchanged behaviour on Arch,
where it is pacman -Q). The menu's guardHelpers prelude fills its set
from dpkg-query plus snap list when pacman is absent and falls back to
omarchy-pkg-installed for names outside the set. omarchy-pkg-add/drop use
apt-get (no AUR: a name without an apt candidate errors out with advice)
and omarchy-pkg-install/remove pick from apt-cache pkgnames and apt-mark
showmanual instead of the Arch repos and yay.
---
 bin/omarchy-pkg-add             | 32 +++++++++++-
 bin/omarchy-pkg-drop            | 29 +++++++++++
 bin/omarchy-pkg-install         | 19 +++++--
 bin/omarchy-pkg-installed       | 91 +++++++++++++++++++++++++++++++++
 bin/omarchy-pkg-missing         |  4 +-
 bin/omarchy-pkg-present         |  4 +-
 bin/omarchy-pkg-remove          | 19 +++++--
 shell/plugins/menu/MenuModel.js | 15 +++++-
 8 files changed, 200 insertions(+), 13 deletions(-)
 create mode 100755 bin/omarchy-pkg-installed

diff --git a/bin/omarchy-pkg-add b/bin/omarchy-pkg-add
index 977d7efd..422946d7 100755
--- a/bin/omarchy-pkg-add
+++ b/bin/omarchy-pkg-add
@@ -5,7 +5,35 @@
 # omarchy:examples=omarchy pkg add jq ripgrep
 # omarchy:requires-sudo=true
 
-if omarchy-pkg-missing "$@"; then
+if ! command -v pacman &>/dev/null; then
+  # Ubuntu port: apt stands in for pacman. Names are the Arch ones, resolved
+  # through omarchy-pkg-installed --apt-names. There is no AUR, so a name with
+  # no apt candidate has to be installed by hand (snap, flatpak, .deb, source).
+  apt_pkgs=()
+  for pkg in "$@"; do
+    omarchy-pkg-installed "$pkg" && continue
+    candidate=""
+    for name in $(omarchy-pkg-installed --apt-names "$pkg"); do
+      if apt-cache policy "$name" 2>/dev/null | grep -q '^  Candidate: [^(]'; then
+        candidate=$name
+        break
+      fi
+    done
+    if [[ -z $candidate ]]; then
+      echo -e "\033[31mError: no apt package for '$pkg' on Ubuntu. Install it by hand (snap, flatpak, .deb, or source).\033[0m" >&2
+      exit 1
+    fi
+    apt_pkgs+=("$candidate")
+  done
+
+  if (( ${#apt_pkgs[@]} > 0 )); then
+    if (( EUID == 0 )); then
+      apt-get install -y "${apt_pkgs[@]}" || exit 1
+    else
+      sudo apt-get install -y "${apt_pkgs[@]}" || exit 1
+    fi
+  fi
+elif omarchy-pkg-missing "$@"; then
   if (( EUID == 0 )); then
     pacman -S --noconfirm --needed "$@" || exit 1
   else
@@ -15,7 +43,7 @@ fi
 
 for pkg in "$@"; do
   # Secondary check to handle states where pacman doesn't actually register an error
-  if ! pacman -Q "$pkg" &>/dev/null; then
+  if ! omarchy-pkg-installed "$pkg"; then
     echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
     exit 1
   fi
diff --git a/bin/omarchy-pkg-drop b/bin/omarchy-pkg-drop
index bfb70598..6fad605d 100755
--- a/bin/omarchy-pkg-drop
+++ b/bin/omarchy-pkg-drop
@@ -8,6 +8,35 @@ installed=()
 declare -A installed_exact=()
 declare -A selected=()
 
+if ! command -v pacman &>/dev/null; then
+  # Ubuntu port: purge the dpkg package, or remove the snap, that answers to
+  # the Arch name (see omarchy-pkg-installed --apt-names).
+  debs=()
+  snaps=()
+  for pkg in "$@"; do
+    for name in $(omarchy-pkg-installed --apt-names "$pkg"); do
+      [[ -z ${selected[$name]} ]] || break
+      if [[ $(dpkg-query -W -f='${db:Status-Abbrev}' "$name" 2>/dev/null) == ?i* ]]; then
+        debs+=("$name")
+        selected[$name]=1
+        break
+      elif snap list "$name" &>/dev/null; then
+        snaps+=("$name")
+        selected[$name]=1
+        break
+      fi
+    done
+  done
+
+  if (( ${#debs[@]} > 0 )); then
+    sudo apt-get purge -y --autoremove "${debs[@]}"
+  fi
+  if (( ${#snaps[@]} > 0 )); then
+    sudo snap remove "${snaps[@]}"
+  fi
+  exit 0
+fi
+
 while IFS= read -r package_name; do
   installed_exact[$package_name]=1
 done < <(pacman -Qq)
diff --git a/bin/omarchy-pkg-install b/bin/omarchy-pkg-install
index 15e5e288..af937380 100755
--- a/bin/omarchy-pkg-install
+++ b/bin/omarchy-pkg-install
@@ -3,9 +3,20 @@
 # omarchy:summary=Show a fuzzy-finder TUI for picking new Arch and OPR packages to install.
 # omarchy:requires-sudo=true
 
+if command -v pacman &>/dev/null; then
+  preview='pacman -Sii {1}'
+  list_packages() { pacman -Slq; }
+  install_packages() { xargs sudo pacman -S --noconfirm; }
+else
+  # Ubuntu port: apt's package list in place of the Arch repos.
+  preview='apt-cache show {1} | sed -n "1,/^$/p"'
+  list_packages() { apt-cache pkgnames | sort; }
+  install_packages() { xargs sudo apt-get install -y; }
+fi
+
 fzf_args=(
   --multi
-  --preview 'pacman -Sii {1}'
+  --preview "$preview"
   --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
   --preview-label-pos='bottom'
   --preview-window 'down:65%:wrap'
@@ -15,12 +26,12 @@ fzf_args=(
   --color 'pointer:green,marker:green'
 )
 
-pkg_names=$(pacman -Slq | fzf "${fzf_args[@]}")
+pkg_names=$(list_packages | fzf "${fzf_args[@]}")
 
 if [[ -n $pkg_names ]]; then
   source omarchy-sudo-keepalive
 
-  # Convert newline-separated selections to space-separated for pacman
-  echo "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -S --noconfirm
+  # Convert newline-separated selections to space-separated for the package manager
+  echo "$pkg_names" | tr '\n' ' ' | install_packages
   omarchy-show-done
 fi
diff --git a/bin/omarchy-pkg-installed b/bin/omarchy-pkg-installed
new file mode 100755
index 00000000..068bfb8e
--- /dev/null
+++ b/bin/omarchy-pkg-installed
@@ -0,0 +1,91 @@
+#!/bin/bash
+
+# omarchy:summary=Returns true if the named package is installed (pacman, or dpkg/snap/flatpak/command on the Ubuntu port)
+# omarchy:args=<package> | --apt-names <package>
+# omarchy:hidden=true
+
+# Ubuntu port. Omarchy names packages the Arch way, so on a system without
+# pacman a name is looked up as an installed dpkg package (or something one
+# provides), a snap, a flatpak whose id contains it, or a command. AUR-style
+# -bin/-git suffixes are dropped and the few names that differ on Ubuntu are
+# mapped below. `--apt-names` prints the apt candidates for a name, in the
+# order omarchy-pkg-add should try them.
+
+set -uo pipefail
+
+declare -A APT_ALIASES=(
+  [google-chrome]="google-chrome-stable"
+  [visual-studio-code-bin]="code"
+  [brave-bin]="brave-browser"
+  [microsoft-edge-stable-bin]="microsoft-edge-stable"
+  [spotify]="spotify-client"
+  [steam]="steam-launcher steam-installer"
+  [sublime-text-4]="sublime-text"
+  [pam-u2f]="libpam-u2f"
+  [dropbox]="nautilus-dropbox dropbox"
+  [libreoffice-fresh]="libreoffice"
+  [docker]="docker-ce docker.io"
+  [docker-compose]="docker-compose-plugin docker-compose-v2"
+)
+
+candidates() {
+  local name=${1%%[<>=]*} base out
+  base=${name%-bin}
+  base=${base%-git}
+  out=$name
+  [[ $base != "$name" ]] && out+=" $base"
+  [[ -n ${APT_ALIASES[$name]-} ]] && out+=" ${APT_ALIASES[$name]}"
+  [[ $base != "$name" && -n ${APT_ALIASES[$base]-} ]] && out+=" ${APT_ALIASES[$base]}"
+  printf '%s\n' $out | awk '!seen[$0]++'
+}
+
+if [[ ${1:-} == "--apt-names" ]]; then
+  candidates "${2:?package name required}"
+  exit 0
+fi
+
+pkg=${1:?package name required}
+
+if command -v pacman &>/dev/null; then
+  pacman -Q "$pkg" &>/dev/null
+  exit
+fi
+
+dpkg_installed() {
+  local status
+  status=$(dpkg-query -W -f='${db:Status-Abbrev}' "$1" 2>/dev/null) || return 1
+  [[ $status == ?i* ]]
+}
+
+# An installed package provides the name (virtual packages, transitional names).
+dpkg_provided() {
+  dpkg-query -W -f='${db:Status-Abbrev}\t${Provides}\n' 2>/dev/null |
+    awk -F'\t' -v want="$1" '
+      $1 ~ /^.i/ {
+        n = split($2, p, ",")
+        for (i = 1; i <= n; i++) {
+          gsub(/^ +| +$| *\(.*\)/, "", p[i])
+          if (p[i] == want) found = 1
+        }
+      }
+      END { exit !found }'
+}
+
+snap_installed() {
+  snap list "$1" &>/dev/null
+}
+
+flatpak_installed() {
+  local needle=${1//-/_}
+  flatpak list --app --columns=application 2>/dev/null | grep -qi -- "$needle"
+}
+
+for name in $(candidates "$pkg"); do
+  dpkg_installed "$name" && exit 0
+  dpkg_provided "$name" && exit 0
+  snap_installed "$name" && exit 0
+  flatpak_installed "$name" && exit 0
+  command -v "$name" &>/dev/null && exit 0
+done
+
+exit 1
diff --git a/bin/omarchy-pkg-missing b/bin/omarchy-pkg-missing
index c4059dff..01421d5e 100755
--- a/bin/omarchy-pkg-missing
+++ b/bin/omarchy-pkg-missing
@@ -3,8 +3,10 @@
 # omarchy:summary=Returns true if any of the named packages are missing from the system (or false if they're all there).
 # omarchy:args=<packages...>
 
+# omarchy-pkg-installed is pacman -Q on Arch and the dpkg/snap/flatpak/command
+# lookup on the Ubuntu port.
 for pkg in "$@"; do
-  if ! pacman -Q "$pkg" &>/dev/null; then
+  if ! omarchy-pkg-installed "$pkg"; then
     exit 0
   fi
 done
diff --git a/bin/omarchy-pkg-present b/bin/omarchy-pkg-present
index 8c4340d6..67f0d453 100755
--- a/bin/omarchy-pkg-present
+++ b/bin/omarchy-pkg-present
@@ -3,8 +3,10 @@
 # omarchy:summary=Returns true if all of the named packages are installed on the system (or false if any of them are missing).
 # omarchy:args=<packages...>
 
+# omarchy-pkg-installed is pacman -Q on Arch and the dpkg/snap/flatpak/command
+# lookup on the Ubuntu port.
 for pkg in "$@"; do
-  pacman -Q "$pkg" &>/dev/null || exit 1
+  omarchy-pkg-installed "$pkg" || exit 1
 done
 
 exit 0
diff --git a/bin/omarchy-pkg-remove b/bin/omarchy-pkg-remove
index 486d3772..8e2df1d1 100755
--- a/bin/omarchy-pkg-remove
+++ b/bin/omarchy-pkg-remove
@@ -3,9 +3,20 @@
 # omarchy:summary=Show a fuzzy-finder TUI for picking packages installed on the system to be removed.
 # omarchy:requires-sudo=true
 
+if command -v pacman &>/dev/null; then
+  preview='yay -Qi {1}'
+  list_packages() { yay -Qqe; }
+  remove_packages() { xargs sudo pacman -Rns --noconfirm; }
+else
+  # Ubuntu port: the manually installed apt packages.
+  preview='apt-cache show {1} | sed -n "1,/^$/p"'
+  list_packages() { apt-mark showmanual | sort; }
+  remove_packages() { xargs sudo apt-get purge -y --autoremove; }
+fi
+
 fzf_args=(
   --multi
-  --preview 'yay -Qi {1}'
+  --preview "$preview"
   --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
   --preview-label-pos='bottom'
   --preview-window 'down:65%:wrap'
@@ -15,10 +26,10 @@ fzf_args=(
   --color 'pointer:red,marker:red'
 )
 
-pkg_names=$(yay -Qqe | fzf "${fzf_args[@]}")
+pkg_names=$(list_packages | fzf "${fzf_args[@]}")
 
 if [[ -n $pkg_names ]]; then
-  # Convert newline-separated selections to space-separated for yay
-  echo "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -Rns --noconfirm
+  # Convert newline-separated selections to space-separated for the package manager
+  echo "$pkg_names" | tr '\n' ' ' | remove_packages
   omarchy-show-done
 fi
diff --git a/shell/plugins/menu/MenuModel.js b/shell/plugins/menu/MenuModel.js
index c6dc7ed3..d46c3ce1 100644
--- a/shell/plugins/menu/MenuModel.js
+++ b/shell/plugins/menu/MenuModel.js
@@ -407,15 +407,28 @@ var GUARD_READERS = [
 // is set in the environment, which a login shell may well have done, so the
 // parser follows the indented lines rather than reading the first one and
 // dropping half of what is installed.
+//
+// Ubuntu port: without pacman the set is filled from dpkg (installed packages
+// and what they provide) plus the installed snaps, and a name outside the set
+// is handed to omarchy-pkg-installed, which knows the Ubuntu aliases, the
+// flatpaks and the command fallback.
 function guardHelpers() {
   return 'declare -A __omarchy_pkgs=()\n'
+    + 'if command -v pacman &>/dev/null; then\n'
     + 'mapfile -t __omarchy_pkg_names < <({ pacman -Qq; LC_ALL=C pacman -Qi'
     + " | awk '/^[A-Za-z]/ { provides = ($0 ~ /^Provides/); sub(/^[^:]*: /, \"\") }"
     + ' provides && $0 != "None" { n = split($0, p, " ");'
     + ' for (i = 1; i <= n; i++) { sub(/[<>=].*/, "", p[i]); print p[i] } }\'; } 2>/dev/null)\n'
+    + 'else\n'
+    + "mapfile -t __omarchy_pkg_names < <({ dpkg-query -W -f='${db:Status-Abbrev}\\t${binary:Package}\\t${Provides}\\n'"
+    + " | awk -F'\\t' '$1 ~ /^.i/ { sub(/:.*/, \"\", $2); print $2; n = split($3, p, \",\");"
+    + ' for (i = 1; i <= n; i++) { gsub(/^ +| +$| *\\(.*\\)/, "", p[i]); if (p[i] != "") print p[i] } }\';'
+    + " snap list 2>/dev/null | awk 'NR > 1 { print $1 }'; } 2>/dev/null)\n"
+    + 'fi\n'
     + 'for __omarchy_pkg in "${__omarchy_pkg_names[@]}"; do __omarchy_pkgs[$__omarchy_pkg]=1; done\n'
     + '__omarchy_pkg_has() { [[ -n ${__omarchy_pkgs[$1]-} ]] && return 0; '
-    + '[[ $1 == *[\\<\\>=]* ]] && { pacman -Q "$1" &>/dev/null; return; }; return 1; }\n'
+    + 'if command -v pacman &>/dev/null; then [[ $1 == *[\\<\\>=]* ]] && { pacman -Q "$1" &>/dev/null; return; }; return 1; fi; '
+    + 'omarchy-pkg-installed "$1"; }\n'
     + 'omarchy-pkg-present() { local p; for p in "$@"; do __omarchy_pkg_has "$p" || return 1; done; return 0; }\n'
     + 'omarchy-pkg-missing() { local p; for p in "$@"; do __omarchy_pkg_has "$p" || return 0; done; return 1; }\n'
     + 'omarchy-cmd-present() { local c; for c in "$@"; do command -v "$c" &>/dev/null || return 1; done; return 0; }\n'
