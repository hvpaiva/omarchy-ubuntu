From cb9992e5fcce4cc8902338afe8cc2b2a224db2ed Mon Sep 17 00:00:00 2001
From: Highlander Paiva <contact@hvpaiva.dev>
Date: Wed, 21 Oct 2026 23:44:11 -0300
Subject: [PATCH 12/12] Ubuntu port: passwordless sudo's lock in /run, its
 cleanup without ALPM

The helper serializes its root actions on a lock in /run/lock and refuses a
lock directory others can write; Ubuntu mounts /run/lock world-writable
(1777), so every privileged action stopped there. The lock moves to /run,
root's and 0755, which the helper already asserts.

Temporary grants also required the settings package's ALPM hook, which
revokes them before the package changes. There is no ALPM on Ubuntu: the
port's root step that replaces or removes the helper's /usr/bin copy runs
__package-removing first and clears the marker once boot cleanup exists,
so a temporary grant requires the boot cleanup rule alone.
---
 bin/omarchy-sudo-passwordless | 28 +++++++---------------------
 1 file changed, 7 insertions(+), 21 deletions(-)

diff --git a/bin/omarchy-sudo-passwordless b/bin/omarchy-sudo-passwordless
index badf65ea..350858ff 100755
--- a/bin/omarchy-sudo-passwordless
+++ b/bin/omarchy-sudo-passwordless
@@ -23,9 +23,8 @@ fi
 set -euo pipefail
 
 readonly MAX_MINUTES=1440
-readonly LOCK_FILE=/run/lock/omarchy-sudo-passwordless.lock
+readonly LOCK_FILE=/run/omarchy-sudo-passwordless.lock
 readonly BOOT_CLEANUP_FILE=/etc/tmpfiles.d/omarchy-nopasswd-sudo.conf
-readonly PACKAGE_HOOK=/usr/share/libalpm/hooks/05-omarchy-passwordless-revoke.hook
 readonly REMOVAL_BLOCKER=/run/omarchy-sudo-passwordless-package-removing
 readonly MIGRATION_MARKER=/var/lib/omarchy/migrations/1788163635
 readonly QUARANTINE_DIR=/var/lib/omarchy/sudoers-quarantine
@@ -81,11 +80,9 @@ with_root_lock() {
   local fd rc=0
   # The boot cleanup cannot depend on STATE_DIR or RUNTIME_DIR being healthy:
   # those are exactly the kinds of partial-install state it must fail closed
-  # through. /run/lock is established by the OS before sysinit services run.
+  # through. /run is established by the OS before sysinit services run, and
+  # only root writes there; Ubuntu's /run/lock is world-writable (1777).
   omarchy_security_assert_root_directory /run 755 || return 1
-  [[ -d /run/lock && ! -L /run/lock ]] || return 1
-  [[ $(/usr/bin/stat -Lc '%u' /run/lock) == 0 ]] || return 1
-  ! ((8#$(/usr/bin/stat -Lc '%a' /run/lock) & 022)) || return 1
   exec {fd}>"$LOCK_FILE" || return 1
   /usr/bin/chown root:root "$LOCK_FILE" || return 1
   /usr/bin/chmod 0600 "$LOCK_FILE" || return 1
@@ -243,26 +240,15 @@ verify_root_path() {
   done
 }
 
+# No ALPM hook on Ubuntu: the port's root step that replaces or removes this
+# command's /usr/bin copy runs __package-removing first, as the hook does
+# before a settings transaction, and clears the marker once boot cleanup exists.
 verify_boot_cleanup() {
-  local active_rules hook
+  local active_rules
   [[ ! -e $REMOVAL_BLOCKER && ! -L $REMOVAL_BLOCKER ]] || return 1
   verify_root_path "$BOOT_CLEANUP_FILE" || return 1
   active_rules=$(/usr/bin/awk '!/^[[:space:]]*(#|$)/ { print }' "$BOOT_CLEANUP_FILE") || return 1
   [[ $active_rules == 'r! /etc/sudoers.d/99-omarchy-nopasswd-*' ]] || return 1
-  verify_root_path "$PACKAGE_HOOK" || return 1
-  hook=$(/usr/bin/cat -- "$PACKAGE_HOOK") || return 1
-  [[ $hook == '[Trigger]
-Operation = Upgrade
-Operation = Remove
-Type = Package
-Target = omarchy-settings
-Target = omarchy-settings-dev
-
-[Action]
-Description = Revoking temporary Omarchy sudo grants before settings changes...
-When = PreTransaction
-Exec = /usr/bin/omarchy-sudo-passwordless __package-removing
-AbortOnFail' ]]
 }
 
 package_removing_locked() {
