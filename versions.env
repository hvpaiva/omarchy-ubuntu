# Pinned versions for everything the bootstrap clones or downloads.
# Bump deliberately: the Omarchy tag and the Quickshell build move together
# (the shell is written against the Quickshell Omarchy packages), and the Qt
# version is what Arch's snapshot carries, which both are tested against.

OMARCHY_REPO=${OMARCHY_REPO:-https://github.com/omacom/omarchy.git}
OMARCHY_FORK=${OMARCHY_FORK:-}            # your fork with the `ubuntu` branch; empty = apply the series under ./patches
OMARCHY_BRANCH=${OMARCHY_BRANCH:-ubuntu}
# The tag each channel sits on (lib/channel.sh). A tag moves here once the port
# was checked against it; edge follows upstream's default branch and has no pin.
OMARCHY_TAG_STABLE=${OMARCHY_TAG_STABLE:-v4.0.6}
OMARCHY_TAG_RC=${OMARCHY_TAG_RC:-v4.5.0-rc1}  # the rc ring carries the release again once no newer pre-release is out

QT_VERSION=${QT_VERSION:-6.12.0}
QT_MODULES=${QT_MODULES:-"qtshadertools qtimageformats qtmultimedia"}
QT_ARCHIVES=${QT_ARCHIVES:-"icu qtbase qtdeclarative qtsvg qtwayland qtshadertools qtimageformats qtmultimedia"}

# Quickshell at the commit Omarchy's package pins (omacom/omarchy-pkgs,
# pkgbuilds/quickshell), with the patch that package carries for Qt 6.12: the
# shell's `//@ pragma OmarchyLoadPatch` only means something to that build.
QUICKSHELL_VERSION=${QUICKSHELL_VERSION:-2b4501a282689792b62e94f3fb30d8f512324fe6}
OMARCHY_PKGS_COMMIT=${OMARCHY_PKGS_COMMIT:-f02b6e6f8406fed5e56726b063b4113bfba76eb8}
WAYLAND_XML_VERSION=${WAYLAND_XML_VERSION:-1.24.0}   # wl_fixes appears in libwayland 1.23; noble ships 1.22

TENSAKU_VERSION=${TENSAKU_VERSION:-v0.29.0}
TTFX_VERSION=${TTFX_VERSION:-v0.5.0}
OMACALC_VERSION=${OMACALC_VERSION:-v0.3.1}
OMAWRITE_VERSION=${OMAWRITE_VERSION:-v0.7.0}
OMACUT_VERSION=${OMACUT_VERSION:-v0.7.2}
HYPE_VERSION=${HYPE_VERSION:-v0.6.0}
MONOLOGUE_VERSION=${MONOLOGUE_VERSION:-v0.3.1}
OMASNAP_VERSION=${OMASNAP_VERSION:-v1.21.0}
OWE_VERSION=${OWE_VERSION:-v0.2.11}                 # owe and owe-lockfeed, one repository
SIGNED_VERSION=${SIGNED_VERSION:-v0.3.1}
TITLEBARS_VERSION=${TITLEBARS_VERSION:-v0.2.2}
LAYER_SHELL_QT_VERSION=${LAYER_SHELL_QT_VERSION:-v6.7.5}   # omasnap's layer-shell; noble only has the Qt 5 build
ECM_VERSION=${ECM_VERSION:-v6.30.0}                 # layer-shell-qt's cmake modules
CMAKE_VERSION=${CMAKE_VERSION:-4.4.3}               # from mise: ECM wants CMake 3.29, noble ships 3.28
CLIAMP_VERSION=${CLIAMP_VERSION:-v2.3.0}
HERDR_VERSION=${HERDR_VERSION:-v0.9.1}
AETHER_VERSION=${AETHER_VERSION:-v4.32.0}
SHARE_PICKER_VERSION=${SHARE_PICKER_VERSION:-v0.2.1}
GSR_VERSION=${GSR_VERSION:-6.1.4}
GTK4_LAYER_SHELL_VERSION=${GTK4_LAYER_SHELL_VERSION:-v1.3.0}
XDG_TERMINAL_EXEC_VERSION=${XDG_TERMINAL_EXEC_VERSION:-v0.14.3}
HYPRPICKER_VERSION=${HYPRPICKER_VERSION:-v0.4.7}

VOXTYPE_VERSION=${VOXTYPE_VERSION:-1.1.1}
LOCALSEND_VERSION=${LOCALSEND_VERSION:-1.18.2}
GUM_VERSION=${GUM_VERSION:-2.0.2}
FASTFETCH_VERSION=${FASTFETCH_VERSION:-2.70.0}
MISE_VERSION=${MISE_VERSION:-2026.10.17}
GHOSTTY_VERSION=${GHOSTTY_VERSION:-1.3.1}
GHOSTTY_DEB=${GHOSTTY_DEB:-$GHOSTTY_VERSION-0.ppa2}   # mkasberg/ghostty-ubuntu's build of it, as its release asset spells the revision (dpkg says ~ppa2)
NERD_FONTS_VERSION=${NERD_FONTS_VERSION:-v3.5.1}
FCITX5_THEME_VERSION=${FCITX5_THEME_VERSION:-5.1.22}   # the first fcitx5 with the SVG glyphs Omarchy's candidate theme links; noble has 5.1.7
DEEPFILTER_VERSION=${DEEPFILTER_VERSION:-0.5.6}
DEEPFILTER_SHA256=${DEEPFILTER_SHA256:-2ca3205c2911d389604a826a240e745597d50252b5cab81c8248252b335e2236}
