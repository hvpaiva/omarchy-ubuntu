# Pinned versions for everything the bootstrap clones or downloads.
# Bump deliberately: the Omarchy tag and the Quickshell version move together
# (the shell is written against a specific Quickshell), and the Qt version is
# what Quickshell was built against on the reference machine.

OMARCHY_REPO=${OMARCHY_REPO:-https://github.com/omacom/omarchy.git}
OMARCHY_FORK=${OMARCHY_FORK:-}            # your fork with the `ubuntu` branch; empty = apply patches from ./patches
OMARCHY_TAG=${OMARCHY_TAG:-v4.0.4}
OMARCHY_BRANCH=${OMARCHY_BRANCH:-ubuntu}

QT_VERSION=${QT_VERSION:-6.11.2}
QT_MODULES=${QT_MODULES:-"qtshadertools qtimageformats qtmultimedia"}
QT_ARCHIVES=${QT_ARCHIVES:-"icu qtbase qtdeclarative qtsvg qtwayland qtshadertools qtimageformats qtmultimedia"}

QUICKSHELL_VERSION=${QUICKSHELL_VERSION:-v0.3.1}
WAYLAND_XML_VERSION=${WAYLAND_XML_VERSION:-1.24.0}   # wl_fixes appears in libwayland 1.23; noble ships 1.22

TENSAKU_VERSION=${TENSAKU_VERSION:-v0.29.0}
TTFX_VERSION=${TTFX_VERSION:-v0.3.2}
OMACALC_VERSION=${OMACALC_VERSION:-v0.2.2}
OMAWRITE_VERSION=${OMAWRITE_VERSION:-v0.5.0}
OMACUT_VERSION=${OMACUT_VERSION:-v0.4.0}
CLIAMP_VERSION=${CLIAMP_VERSION:-v2.2.0}
HERDR_VERSION=${HERDR_VERSION:-v0.9.1}
AETHER_VERSION=${AETHER_VERSION:-v4.29.9}
SHARE_PICKER_VERSION=${SHARE_PICKER_VERSION:-v0.2.1}
GSR_VERSION=${GSR_VERSION:-6.1.0}
GTK4_LAYER_SHELL_VERSION=${GTK4_LAYER_SHELL_VERSION:-v1.3.0}
XDG_TERMINAL_EXEC_VERSION=${XDG_TERMINAL_EXEC_VERSION:-v0.13.0}
HYPRPICKER_VERSION=${HYPRPICKER_VERSION:-v0.4.5}

VOXTYPE_VERSION=${VOXTYPE_VERSION:-1.0.1}
LOCALSEND_VERSION=${LOCALSEND_VERSION:-1.18.2}
GUM_VERSION=${GUM_VERSION:-0.17.0}
NERD_FONTS_VERSION=${NERD_FONTS_VERSION:-v3.4.0}
DEEPFILTER_VERSION=${DEEPFILTER_VERSION:-0.5.6}
DEEPFILTER_SHA256=${DEEPFILTER_SHA256:-2ca3205c2911d389604a826a240e745597d50252b5cab81c8248252b335e2236}
