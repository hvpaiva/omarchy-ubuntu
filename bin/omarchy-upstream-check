#!/bin/bash

# What the next Omarchy brings for the port, before anything is touched.
# Works on a throwaway clone: the port's patches are applied on the base tag
# and rebased onto the target, the package lists and the migrations are
# diffed, and the upstream directories the port mirrors by hand are listed.
# Nothing here needs root or changes the checkout, so it runs in CI as well as
# on the machine (`omarchy-update-ubuntu` points at it before updating).
#
#   omarchy-upstream-check                  # this machine's channel: its base -> the newest ref the channel admits
#   omarchy-upstream-check --channel rc     # another channel: its pin -> its newest
#   omarchy-upstream-check --branch         # base -> upstream's default branch, what edge follows
#   omarchy-upstream-check --base v4.0.3 --target v4.0.4
#   omarchy-upstream-check --repo <dir|url> # where to read upstream from
#
# Output is Markdown (the CI job posts it as an issue). Exit status is 0 when
# the patches rebase cleanly and every new package has a source on Ubuntu,
# 1 otherwise, so a job can tell "read this" from "nothing to do".

# shellcheck disable=SC2016  # backticks inside sed programs are Markdown, not expansions
set -uo pipefail

PORT_DIR=${OMARCHY_UBUNTU_DIR:-$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}
OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}

repo=""
base=""
target=""
branch=0
channel=""
while (( $# )); do
  case $1 in
    --repo) repo=$2; shift 2 ;;
    --base) base=$2; shift 2 ;;
    --target) target=$2; shift 2 ;;
    --branch) branch=1; shift ;;
    --channel) channel=$2; shift 2 ;;
    -h | --help) sed -n '3,18p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
# An explicit channel is read as a fresh machine on it would: its pin, its
# series. Without one, the machine's own channel and the base its checkout is on.
[[ -z $channel ]] || OMARCHY_CHANNEL=$channel
# shellcheck source=../lib/channel.sh
source "$PORT_DIR/lib/channel.sh" || exit 2
# shellcheck source=../lib/units.sh
source "$PORT_DIR/lib/units.sh"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
clone=$work/omarchy

# The clone always comes from upstream's URL, without blobs. A local checkout
# (the machine's dev link) only serves as a reference for the objects it has:
# it is itself a blobless clone, so sharing it outright would leave the rebase
# without the files it needs.
if [[ -z $repo ]]; then
  if git -C "$OMARCHY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    repo=$OMARCHY_PATH
  else
    repo=$OMARCHY_REPO
  fi
fi
if [[ -d $repo ]]; then
  url=$(git -C "$repo" remote get-url origin)
  git clone --quiet --filter=blob:none --no-checkout --reference-if-able "$repo" "$url" "$clone" || exit 2
else
  git clone --quiet --filter=blob:none --no-checkout "$repo" "$clone" || exit 2
fi
# Only the directories the patches and the mirrored steps touch are checked
# out: the themes alone are most of the tree, and none of this reads them.
git -C "$clone" sparse-checkout set bin default shell etc install config migrations >/dev/null
git -C "$clone" fetch --quiet --tags origin
git -C "$clone" remote set-head origin --auto >/dev/null 2>&1
default_branch=$(git -C "$clone" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
default_branch=${default_branch#origin/}

g() { git -C "$clone" "$@"; }

if [[ -z $base ]]; then
  if [[ -z $channel && -d $repo ]] && git -C "$repo" show-ref --verify --quiet refs/heads/"$OMARCHY_BRANCH"; then
    base=$(git -C "$repo" describe --tags --abbrev=0 "$OMARCHY_BRANCH")
  else
    base=$(channel_tag)
    # edge and dev have no pin; what they bring is measured from rc's.
    [[ -n $base ]] || base=$OMARCHY_TAG_RC
  fi
fi
if (( branch )); then
  target=origin/$default_branch
elif [[ -z $target ]]; then
  target=$(channel_newest "$OMARCHY_CHANNEL" "$clone")
fi
series=$(channel_patches)
g rev-parse --verify --quiet "$base^{commit}" >/dev/null || { echo "unknown base: $base" >&2; exit 2; }
g rev-parse --verify --quiet "$target^{commit}" >/dev/null || { echo "unknown target: $target" >&2; exit 2; }

status=0
problem() { status=1; }

# A package name is known to the port when it is on one of the apt lists, when
# omarchy-pkg-ubuntu (the fork's backend) has a recipe or alias for it, or when
# apt on this machine offers it. The backend's tables are read from the tree
# the port's patches were applied on, so a recipe added by a newer patch counts.
resolver=""
classify_pkg() {
  local name=$1 apt n stem keys
  if [[ -n $resolver ]]; then
    # The backend also looks a -bin or -git name up without the suffix.
    stem=${name%-bin}
    stem=${stem%-git}
    keys=$(printf '%s\n' "$name" "$stem" | sed 's/[][\.*^$+?(){}|]/\\&/g' | paste -sd'|')
    if grep -qE "^\s*\[($keys)\]=" "$resolver"; then
      echo "recipe or alias in omarchy-pkg-ubuntu"
      return 0
    fi
    apt=$("$resolver" apt-names "$name" 2>/dev/null)
  else
    apt=$name
  fi
  for n in $apt; do
    if grep -hqxE "$n(\s.*)?" "$PORT_DIR"/packages/*.txt 2>/dev/null; then
      echo "on packages/*.txt as $n"
      return 0
    fi
  done
  if command -v apt-cache >/dev/null 2>&1; then
    for n in $apt; do
      if [[ -n $(LC_ALL=C apt-cache policy "$n" 2>/dev/null | awk '/^  Candidate:/ && $2 != "(none)" { print $2 }') ]]; then
        echo "apt offers $n here (not on the lists yet)"
        return 0
      fi
    done
  fi
  echo "no Ubuntu source known"
  return 1
}

pkg_names() {
  g show "$1:install/omarchy-base.packages" "$1:install/omarchy-other.packages" 2>/dev/null |
    grep -vE '^\s*(#|$)' | sed 's/\s.*//' | sort -u
}

echo "# Omarchy $base -> $target ($OMARCHY_CHANNEL channel)"
echo
echo "Port \`$(git -C "$PORT_DIR" describe --always --dirty 2>/dev/null)\`, series \`${series#"$PORT_DIR/"}\`, upstream $(g rev-parse --short "$target") ($(g log -1 --format=%cs "$target")), $(g rev-list --count "$base..$target") commits since $base."
if [[ $target == origin/* ]]; then
  echo "Preview of the branch \`$default_branch\`; the newest release tag is $(channel_newest stable "$clone"), the newest tag of any kind $(channel_newest rc "$clone")."
fi
echo

echo "## Patches"
echo
# The series goes on the tag it was cut on and moves to the target by rebase,
# exactly what omarchy-update-ubuntu does on the machine.
series_base=$(channel_series_base) || exit 2
g rev-parse --verify --quiet "$series_base^{commit}" >/dev/null || { echo "unknown series base: $series_base" >&2; exit 2; }
g checkout --quiet -B check "$series_base" 2>/dev/null
if ! g -c user.name=port -c user.email=port@localhost -c commit.gpgsign=false am --quiet "$series"/*.patch 2>"$work/am.err"; then
  echo "The port's patches no longer apply on $series_base, the tag \`${series#"$PORT_DIR/"}\` was cut on:"
  echo
  sed 's/^/    /' "$work/am.err"
  g am --abort 2>/dev/null
  problem
else
  resolver=$clone/bin/omarchy-pkg-ubuntu
  # --onto: only the patches move. Release tags are cut on their own branch, so
  # the default branch need not contain the base and a plain rebase would
  # replay upstream's own history.
  if g -c user.name=port -c user.email=port@localhost -c commit.gpgsign=false rebase --quiet --onto "$target" "$series_base" check >"$work/rebase.out" 2>&1; then
    echo "The $(g rev-list --count "$target..check") patches rebase cleanly onto $target."
  else
    echo "Rebase conflict in \"$(g log -1 --format=%s REBASE_HEAD 2>/dev/null)\":"
    echo
    g diff --name-only --diff-filter=U | sed 's/^/- `/; s/$/`/'
    g rebase --abort 2>/dev/null
    problem
  fi
fi
echo

echo "## Packages"
echo
comm -13 <(pkg_names "$base") <(pkg_names "$target") >"$work/added"
comm -23 <(pkg_names "$base") <(pkg_names "$target") >"$work/removed"
if [[ ! -s $work/added && ! -s $work/removed ]]; then
  echo "No change in \`install/omarchy-base.packages\` or \`install/omarchy-other.packages\`."
else
  while IFS= read -r name; do
    if reason=$(classify_pkg "$name"); then
      echo "- added \`$name\`: $reason"
    else
      echo "- added \`$name\`: **$reason**"
      problem
    fi
  done <"$work/added"
  while IFS= read -r name; do
    var=$(tr 'a-z-' 'A-Z_' <<<"$name")_VERSION
    if grep -qE "^$var=" "$PORT_DIR"/versions.env "$PORT_DIR"/versions.rc.env 2>/dev/null; then
      echo "- removed \`$name\`: **pinned in versions.env, the port still builds or downloads it**"
    elif reason=$(classify_pkg "$name") && [[ $reason == on\ packages/* ]]; then
      echo "- removed \`$name\`: **$reason, drop it there**"
    else
      echo "- removed \`$name\`: nothing to do, the port never installed it"
    fi
  done <"$work/removed"
fi
echo

echo "## Package names in commands and menus"
echo
# What the lists do not hold: a menu entry, a setup command or an install
# helper that asks for a package by name (lib/catalog.py), new at the target.
if ! command -v python3 >/dev/null 2>&1; then
  echo "Not read: python3 is missing here."
else
  for ref in "$base" "$target"; do
    tree=$work/tree-${ref//[^A-Za-z0-9.]/_}
    mkdir -p "$tree"
    g archive "$ref" -- bin default config shell | tar -x -C "$tree"
    python3 "$PORT_DIR/lib/catalog.py" --calls "$tree" >"$tree.calls"
  done
  base_calls=$work/tree-${base//[^A-Za-z0-9.]/_}.calls
  target_calls=$work/tree-${target//[^A-Za-z0-9.]/_}.calls
  comm -13 <(cut -f1 "$base_calls" | sort -u) <(cut -f1 "$target_calls" | sort -u) >"$work/calls-added"
  if [[ ! -s $work/calls-added ]]; then
    echo "No name new at $target."
  else
    while IFS= read -r name; do
      where=$(awk -F'\t' -v n="$name" '$1 == n { print $2 " in `" $3 "`"; exit }' "$target_calls")
      if [[ $name == *'$'* ]]; then
        echo "- $where: a name computed at run time, read the command"
      elif reason=$(classify_pkg "$name"); then
        echo "- \`$name\`, $where: $reason"
      elif awk -F'\t' -v n="$name" '$1 == n && $2 !~ /^(present|missing|drop|remove)$/ { found = 1 } END { exit !found }' "$target_calls"; then
        echo "- \`$name\`, $where: **$reason**"
        problem
      else
        # Only checked for or removed: on Ubuntu it is never there, which is
        # right unless Ubuntu has it under another name.
        echo "- \`$name\`, $where: $reason, only checked for or removed"
      fi
    done <"$work/calls-added"
  fi
fi
echo

echo "## Migrations"
echo
arch_only='pacman|yay|paru|makepkg|mkinitcpio|limine|systemd-boot|/etc/pacman'
g diff --name-only --diff-filter=A "$base" "$target" -- migrations >"$work/migrations"
if [[ ! -s $work/migrations ]]; then
  echo "None new."
else
  while IFS= read -r file; do
    g show "$target:$file" >"$work/migration"
    kind="runs as is"
    grep -qE "$arch_only" "$work/migration" && kind="**Arch tooling, the updater asks**"
    echo "- \`${file#migrations/}\`: $kind"
    grep -oE 'omarchy-pkg-add[^|&;>]*' "$work/migration" | sed 's/omarchy-pkg-add//' | tr ' ' '\n' | grep -v '^$' | sort -u |
      while IFS= read -r name; do
        if [[ $name == *'$'* ]]; then
          echo "  - installs $name: a name computed at run time, read the migration"
          continue
        fi
        if reason=$(classify_pkg "$name"); then
          echo "  - installs \`$name\`: $reason"
        else
          echo "  - installs \`$name\`: **$reason**"
          problem
        fi
      done
  done <"$work/migrations"
fi
echo

echo "## Mirrored by hand"
echo
# Directories the port reproduces outside the checkout (see docs/deviations.md).
# A change here means a port step may need the same change.
mirrored=(
  etc                        # 57-system-tweaks-root.sh, 58-system-extras-root.sh
  default/systemd/user       # 65-session.sh and the updater (all units, minus the skip list)
  install/config             # 55, 57, 58
  install/user               # 60-config.sh, 65-session.sh
  install/helpers            # sourced by the mirrored steps
  config/hypr                # the hyprland.lua and autostart.lua glue, the seeded stubs
  config/omarchy             # seeded user config
  bin/omarchy-theme-set-browser-policy
  bin/omarchy-dns
)
g diff --name-status "$base" "$target" -- "${mirrored[@]}" >"$work/mirrored"
if [[ ! -s $work/mirrored ]]; then
  echo "Nothing changed in the directories the port mirrors."
else
  sed -E 's/^A\t(.*)/- added `\1`/; s/^M\t(.*)/- changed `\1`/; s/^D\t(.*)/- removed `\1`/; s/^R[0-9]*\t(.*)\t(.*)/- renamed `\1` -> `\2`/' "$work/mirrored"
fi
g checkout --quiet "$target" 2>/dev/null
unhandled=$(OMARCHY_PATH=$clone REPO_DIR=$PORT_DIR "$PORT_DIR/install/57-system-tweaks-root.sh" --unhandled 2>/dev/null)
if [[ -n $unhandled ]]; then
  echo
  echo "Files under \`etc/\` at $target that step 57 neither installs nor lists as skipped:"
  echo
  sed 's/^/- `/; s/$/`/' <<<"$unhandled"
fi
echo

echo "## User units"
echo
if new_units=$(g diff --name-only --diff-filter=A "$base" "$target" -- default/systemd/user | grep '\.service$'); then
  while IFS= read -r unit; do
    if printf '%s\n' "${OMARCHY_UNITS_SKIP[@]}" | grep -qx "$(basename "$unit")"; then
      echo "- \`$(basename "$unit")\`: on the port's skip list"
    else
      echo "- \`$(basename "$unit")\`: the updater installs it; check whether upstream's first-run enables it (\`install/user/first-run/enable-user-units.sh\`)"
    fi
  done <<<"$new_units"
else
  echo "No new unit."
fi
echo

echo "## Versions"
echo
# What versions.env pins against what the channel's ring and upstream's Arch
# snapshot mirror carry at the target: the port builds or downloads what
# upstream packages, so a pin behind either is drift. Both are pacman
# databases, zstd tars of <name>-<version>-<release>/desc entries, read off
# the pacman configuration the target ships.
case $OMARCHY_CHANNEL in
  stable | rc) ring=$OMARCHY_CHANNEL ;;
  *) ring=edge ;;
esac
db_versions() { # db_versions <url> <file>: one "name<TAB>version" per package
  curl -fsSL -o "$2" "$1" 2>/dev/null && tar --zstd -tf "$2" 2>/dev/null |
    sed -n 's#/$##p' | awk -F- '{ ver = $(NF - 1); NF -= 2; OFS = "-"; $1 = $1; print $0 "\t" ver }'
}
ring_url=$(g show "$target:default/pacman/pacman-$ring.conf" 2>/dev/null | sed -n 's#^Server = \(https://pkgs\.omarchy\.org/[a-z]*/\)\$arch$#\1x86_64/omarchy.db#p' | head -n1)
mirror_url=$(g show "$target:default/pacman/mirrorlist-$ring" 2>/dev/null | sed -n 's#^Server = \(.*\)\$repo/os/\$arch$#\1extra/os/x86_64/extra.db#p' | head -n1)
declare -A ring_package=(
  [TENSAKU]=tensaku [TTFX]=ttfx [OMACALC]=omacalc [OMAWRITE]=omawrite [OMACUT]=omacut [HYPE]=hype
  [MONOLOGUE]=monologue [OMASNAP]=omasnap [OWE]=owe [SIGNED]=signed [TITLEBARS]=omarchy-hyprland-titlebars
  [CLIAMP]=cliamp [HERDR]=herdr [AETHER]=aether [SHARE_PICKER]=hyprland-preview-share-picker
  [VOXTYPE]=voxtype-bin [LOCALSEND]=localsend [QUICKSHELL]=quickshell
)
declare -A mirror_package=(
  [QT]=qt6-base [GUM]=gum [FASTFETCH]=fastfetch [GHOSTTY]=ghostty [MISE]=mise [HYPRPICKER]=hyprpicker [XDG_TERMINAL_EXEC]=xdg-terminal-exec
  [GSR]=gpu-screen-recorder [GTK4_LAYER_SHELL]=gtk4-layer-shell [NERD_FONTS]=ttf-jetbrains-mono-nerd
)
matched=0
compare_pins() { # compare_pins <what> <url> <map name>
  local what=$1 url=$2 var pin_var pin theirs name
  local -n map=$3
  if [[ -z $url ]]; then
    echo "- $what: no pacman configuration for the $ring ring at $target"
    problem
    return
  fi
  if ! db_versions "$url" "$work/$what.db" >"$work/$what.tsv" || [[ ! -s $work/$what.tsv ]]; then
    echo "- $what: could not read $url (network, or no zstd for tar)"
    problem
    return
  fi
  for var in $(printf '%s\n' "${!map[@]}" | sort); do
    name=${map[$var]}
    pin_var=${var}_VERSION
    pin=${!pin_var#v}
    theirs=$(awk -F'\t' -v n="$name" '$1 == n { print $2; exit }' "$work/$what.tsv")
    if [[ -z $theirs ]]; then
      echo "- \`$name\`: port $pin, not in the $what"
    # A commit pinned here is spelled by pacman as <version>.r<n>.g<short hash>.
    elif [[ $pin != "$theirs" && $theirs != *.g"${pin:0:7}" ]]; then
      echo "- \`$name\`: **port $pin, $what $theirs**"
      problem
    else
      matched=$((matched + 1))
    fi
  done
}
compare_pins "$ring ring" "$ring_url" ring_package
compare_pins "snapshot mirror" "$mirror_url" mirror_package
echo "- $matched of $(( ${#ring_package[@]} + ${#mirror_package[@]} )) pins match."

exit $status
