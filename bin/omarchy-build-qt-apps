#!/bin/bash
# Omarchy's Qt Quick apps (omacalc, omawrite, omacut), as the bootstrap has always
# called them. The build itself lives in omarchy-build-app, with the other apps.
#
#   omarchy-build-qt-apps [omacalc|omawrite|omacut ...]   (default: all three)
apps=("$@")
(( ${#apps[@]} > 0 )) || apps=(omacalc omawrite omacut)
exec "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/omarchy-build-app" "${apps[@]}"
