#!/usr/bin/env python3
import getpass
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

BUS = "org.freedesktop.secrets"
ROOT = "/org/freedesktop/secrets"
LOGIN = ROOT + "/collection/login"
DEFAULT = ROOT + "/collection/Default_5fkeyring"

if not sys.stdin.isatty():
    sys.exit("run this from a terminal: it reads the current keyring password")

bus = Gio.bus_get_sync(Gio.BusType.SESSION)


def call(path, iface, method, args, reply):
    return bus.call_sync(BUS, path, iface, method, args, GLib.VariantType(reply), Gio.DBusCallFlags.NONE, -1, None).unpack()


def prop(name):
    return call(ROOT, "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("org.freedesktop.Secret.Service", name)), "(v)")[0]


if DEFAULT not in prop("Collections"):
    sys.exit("Default_keyring is missing: run $OMARCHY_PATH/install/user/default-keyring.sh "
             "and restart gnome-keyring-daemon.service first")

_, session = call(ROOT, "org.freedesktop.Secret.Service", "OpenSession",
                  GLib.Variant("(sv)", ("plain", GLib.Variant("s", ""))), "(vo)")


def secret(text):
    return (session, b"", text.encode(), "text/plain")


old = getpass.getpass("Current password of the login keyring: ")
call(ROOT, "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface", "ChangeWithMasterPassword",
     GLib.Variant("(o(oayays)(oayays))", (LOGIN, secret(old), secret(""))), "()")
call(ROOT, "org.freedesktop.Secret.Service", "SetAlias", GLib.Variant("(so)", ("default", DEFAULT)), "()")
print("login keyring has no password; default alias -> Default_keyring")
