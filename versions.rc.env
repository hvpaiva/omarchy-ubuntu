# What the rc channel pins differently from versions.env; edge and dev read it
# too, as they build what the rc ring carries. lib/channel.sh sources it after
# versions.env, so a plain assignment here (no ${X:-} default) is what wins.

OMAWRITE_VERSION=v0.7.2
# What upstream's Arch snapshot for v4.5.0-rc1 carries; stable's stays at its tag's.
MISE_VERSION=2026.10.17
