#%PAM-1.0
# omarchy-shell lock screen, password (Ubuntu, omarchy-ubuntu). Upstream's
# omarchy-apply-lock uses system-local-login and pam_faillock, which Ubuntu
# lacks; this mirrors common-auth without pam_fprintd (the fingerprint has its
# own stack, omarchy-lock-fingerprint), and account comes from common-account.
auth    [success=2 default=ignore]      pam_unix.so nullok try_first_pass
auth    [success=1 default=ignore]      pam_sss.so use_first_pass
auth    requisite                       pam_deny.so
auth    required                        pam_permit.so
@include common-account
